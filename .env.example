POSTGRES_DB=bookkeeping_tax
POSTGRES_USER=bookkeeping
POSTGRES_PASSWORD=bookkeeping
POSTGRES_PORT=5432

API_PORT=8000
API_HOST=0.0.0.0
API_ENV=development
API_DATABASE_URL=postgresql+psycopg://bookkeeping:bookkeeping@db:5432/bookkeeping_tax
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,http://web:3000
API_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2})(?::\d+)?$
API_SECRET_KEY=change-me-development-key-with-at-least-32-bytes
API_DOCUMENT_STORAGE_PATH=./storage/documents
API_JOURNAL_AI_WEB_SEARCH_ENABLED=true
API_JOURNAL_AI_MAX_FILE_COUNT=50
API_JOURNAL_AI_MAX_FILE_SIZE_BYTES=10485760
API_JOURNAL_AI_MAX_TOTAL_SIZE_BYTES=104857600
API_JOURNAL_AI_REQUEST_TIMEOUT_SECONDS=90
API_LOG_LEVEL=INFO
API_LOG_JSON=true
API_HEALTHCHECK_TIMEOUT_SECONDS=2
API_METRICS_ENABLED=true
API_ALERT_WEBHOOK_URL=
API_ALERT_WEBHOOK_TIMEOUT_SECONDS=1
API_ALERT_MIN_INTERVAL_SECONDS=300

WEB_PORT=3000
# Leave blank to make the web app use the current browser hostname with NEXT_PUBLIC_API_PORT.
# Set this only when the API is intentionally hosted on a different origin.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_PORT=8000
NEXT_ALLOWED_DEV_ORIGINS=192.168.1.100-253,web

BACKUP_OUTPUT_DIR=./backups
